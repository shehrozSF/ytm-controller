<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device: no cloud backup and no device-to-device transfer. The app's
    data is caches and lookups (rebuilt automatically) plus Google sign-in, which is tied to
    this install's signing key anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
